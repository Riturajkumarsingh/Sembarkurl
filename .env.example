APP_NAME="URL Shortener"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# To use MySQL instead, comment out DB_CONNECTION=sqlite above and set these:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=url_shortener
# DB_USERNAME=root
# DB_PASSWORD=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@urlshortener.test"
MAIL_FROM_NAME="${APP_NAME}"

SUPERADMIN_EMAIL=superadmin@urlshortener.test
SUPERADMIN_PASSWORD=password
